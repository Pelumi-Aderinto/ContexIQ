# ---------------------------------------------------------------------------
# ContextIQ configuration. Copy to .env and edit. Never commit .env.
# All CONTEXTIQ_* values are optional; defaults are shown.
# ---------------------------------------------------------------------------

# ---- LLM provider ----------------------------------------------------------
# Set ONE of these. If none is set, ContextIQ runs in "extractive" mode: it still
# retrieves and cites passages but returns them verbatim instead of a synthesized answer.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# auto | anthropic | openai | groq | extractive   (auto = first provider with a key)
CONTEXTIQ_LLM_PROVIDER=auto
# Override the provider default model (anthropic: claude-opus-5, openai: gpt-5-mini,
# groq: openai/gpt-oss-120b). Cheaper Anthropic option: claude-sonnet-5.
# If your provider returns model_not_found, set this to a model your account can access.
CONTEXTIQ_LLM_MODEL=
CONTEXTIQ_LLM_TEMPERATURE=0.0
CONTEXTIQ_LLM_MAX_TOKENS=1024
CONTEXTIQ_LLM_TIMEOUT_SECONDS=60

# ---- Auth / workspaces -----------------------------------------------------
# api_key (default) | disabled (single shared workspace, local dev only)
CONTEXTIQ_AUTH_MODE=api_key
# Comma-separated "api_key:workspace_id" pairs. Each key is scoped to exactly one workspace.
# These demo keys are for local use only; generate real ones with: python -c "import secrets;print(secrets.token_urlsafe(32))"
CONTEXTIQ_API_KEYS=dev-key-alpha-0001:alpha,dev-key-beta-0002:beta
# Key the Streamlit UI pre-fills (must be one of the keys above)
CONTEXTIQ_UI_API_KEY=dev-key-alpha-0001

# ---- Storage ---------------------------------------------------------------
CONTEXTIQ_DATA_DIR=data

# ---- Ingestion -------------------------------------------------------------
CONTEXTIQ_MAX_UPLOAD_MB=25
CONTEXTIQ_MAX_PAGES=500
CONTEXTIQ_CHUNK_SIZE=1000
CONTEXTIQ_CHUNK_OVERLAP=150

# ---- Embeddings (local, PyTorch via sentence-transformers) -----------------
CONTEXTIQ_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CONTEXTIQ_EMBEDDING_DEVICE=cpu
CONTEXTIQ_EMBEDDING_BATCH_SIZE=32

# ---- Retrieval -------------------------------------------------------------
# dense | hybrid (dense + BM25 with reciprocal rank fusion)
CONTEXTIQ_RETRIEVAL_MODE=hybrid
CONTEXTIQ_TOP_K=5
CONTEXTIQ_MAX_TOP_K=20
CONTEXTIQ_RERANK_ENABLED=false
CONTEXTIQ_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Logging / server ------------------------------------------------------
CONTEXTIQ_LOG_LEVEL=INFO
CONTEXTIQ_LOG_JSON=true
CONTEXTIQ_CORS_ORIGINS=http://localhost:8501
# Backend URL the Streamlit UI talks to
CONTEXTIQ_API_URL=http://localhost:8000
